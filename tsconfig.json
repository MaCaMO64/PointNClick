{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "allowJs": true,
    "checkJs": false,
    "skipLibCheck": true,
    "types": []
  },
  "include": ["js/**/*.js", "index.html"],
  "exclude": ["js/games/**/art-data.js", "js/games/**/music-data.js"]
}
